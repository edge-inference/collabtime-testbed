FROM ros:humble-ros-base

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for Federate (Python + build tools + Java for lfc)
# Note: ROS 2 base image already has Python 3
RUN apt-get update && apt-get install -y \
    curl \
    python3-pip \
    python3-venv \
    python3-dev \
    cmake \
    build-essential \
    openjdk-17-jre \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for ROS 2 nodes
RUN pip3 install networkx numpy pyyaml scipy

# Install Lingua Franca Compiler (lfc) using official installer
RUN curl -Ls https://install.lf-lang.org | bash -s cli

# Add lfc to PATH (installer puts it in ~/.local/bin)
ENV PATH="/root/.local/bin:$PATH"

# Set working directory
WORKDIR /ros2_ws

# Copy ALL source packages
COPY src/ /ros2_ws/src/
COPY scripts/ /ros2_ws/scripts/
COPY config/ /ros2_ws/config/

# Generate + compile one LF federation per fleet size (federation size is fixed
# at LF compile time). Produces, for each N:
#   /ros2_ws/fed-gen/coordinator_<N>/bin/{RTI, federate__f1 .. federate__fN}
# Keep --sizes in sync with fleet_sizes in config/testbed.yaml.
RUN python3 /ros2_ws/scripts/gen_lf.py --sizes 2,4,8,16 --compile

# Source ROS 2 and build ONLY the interfaces package (and dependencies if any)
RUN . /opt/ros/humble/setup.sh && \
    colcon build --packages-select interfaces

# Force install Python packages to system path (standard install)
RUN pip3 install ./src/common ./src/dsm ./src/agent ./src/coord

# Default RTI connection (docker-compose overrides these per run; with
# network_mode: host the federation lives on the host loopback).
ENV LF_RTI_HOST=127.0.0.1
ENV LF_RTI_PORT=15045
ENV LF_FEDERATION_ID=context-fabric-testbed-2025

# Source the workspace for interactive shells
RUN echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

# Compose overrides `command:` for every service; this is just a safe default.
CMD ["/bin/bash"]

